# Neon Postgres connection string (use the "Pooled connection" string from the Neon dashboard).
# Must be reachable with pgvector available (enabled automatically by scripts/migrate.mjs).
DATABASE_URL=

# Vercel Blob read/write token (Project Settings -> Storage -> Blob -> .env.local tab).
BLOB_READ_WRITE_TOKEN=

# API key for the embedding/AI provider used by later RAG phases (not required yet).
# OPENAI_API_KEY=
